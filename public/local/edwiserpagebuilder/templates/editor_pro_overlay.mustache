{{!
    @template local_edwiserpagebuilder/editor_pro_overlay

    @copyright  (c) 2024 WisdmLabs (https://wisdmlabs.com/) <support@wisdmlabs.com>
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Pro overlay and upgrade banner for the editor when pro is not allowed.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * showoverlay - Whether to show the overlay
    * strmobiletaboverlay - Overlay text for mobile tab
    * strupgradetopro - Upgrade to pro button label

    Example context (json):
    {
        "showoverlay": true,
        "strmobiletaboverlay": "",
        "strupgradetopro": ""
    }
}}
{{#showoverlay}}
<div class="disable-overlay">
    <div class="disable-warning para-regular-2">
        <span>{{strmobiletaboverlay}}</span>
        <a href="https://edwiser.org/page-builder-for-moodle/"
            target="_blank" class="upgrade-to-pro-btn"
            title="{{strupgradetopro}}">
        <span>{{strupgradetopro}}</span>
        </a>
    </div>
</div>
{{/showoverlay}}
