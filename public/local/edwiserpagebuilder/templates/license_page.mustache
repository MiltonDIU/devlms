{{#alerts}}
<div class="alert alert-{{type}}">
   <button type="button" class="close" data-dismiss="alert" aria-hidden="true">×</button>
   <h4><i class="icon fa fa-{{icon}}"></i> {{{title}}}</h4>
   {{{message}}}
</div>
{{/alerts}}

<form method="POST">
<div class="license-box box box-warning">
<input type="hidden" name="sesskey" value="{{sesskey}}">
<div class="box-header with-border">
<h3 class="box-title">{{{activationtitle}}}</h3>
</div>

{{#remuiproactive}}
<div class="alert alert-warning mt-2">
<i class="fa fa-info-circle mr-1"></i>
{{{remuiprotext}}}
</div>
{{/remuiproactive}}

<div class="panel-body">
<input type="hidden" name="activetab" value="local_edwiserform_license_status">

<div class="form-group {{licenseinputclass}}">
<label class="control-label text-black col-sm-3">{{{licensekeystr}}}:</label>
<div class="col-sm-9">
<input id="edd_{{pluginslug}}_license_key" class="form-control" name="edd_{{pluginslug}}_license_key"
    type="text" class="regular-text" value="{{licensekey}}" placeholder="{{{placeholder}}}"
    {{#readonly}}readonly{{/readonly}} {{{disabledattr}}}/>
</div>
</div>

<div class="form-group">
<label class="control-label col-sm-3">{{{licensestatusstr}}}:</label>
<div class="col-sm-9">
{{{statustext}}}
</div>
</div>

<div class="form-group">
<div class="col-sm-9">
<input type="hidden" id="onRapidGraderLicensePage" name="onRapidGraderLicensePage" value="1"/>
{{#showdeactivate}}
<input type="submit" class="btn btn-primary text-white" style="color:white;"
    name="edd_{{pluginslug}}_license_deactivate" value="{{{deactivatelicensetext}}}"/>
{{/showdeactivate}}
{{#showrenew}}
<input type="submit" class="btn btn-primary" style="color:white;"
    name="edd_{{pluginslug}}_license_deactivate" value="{{{deactivatelicensetext}}}"/>&nbsp;&nbsp;
<input type="button" class="btn btn-primary" style="color:white;"
    name="edd_{{pluginslug}}_license_renew" value="{{{renewlicensetext}}}"
    onclick="window.open('{{renewlink}}');">
{{/showrenew}}
{{#showactivate}}
<input type="submit" class="btn btn-primary" style="color:white;"
    name="edd_{{pluginslug}}_license_activate" value="{{{activatelicensetext}}}" {{{disabledattr}}}/>
{{/showactivate}}
</div>
</div>
</div>
</div>
</form>
