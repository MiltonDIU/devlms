{{!
    @template local_edwiserpagebuilder/editor_pro_banner

    @copyright  (c) 2024 WisdmLabs (https://wisdmlabs.com/) <support@wisdmlabs.com>
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Bottom panel upgrade banner for the editor when pro is not allowed.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * showbanner - Whether to show the banner
    * strupgradebannertext - Banner text for upgrade prompt
    * strupgradetopro - Upgrade to pro button label

    Example context (json):
    {
        "showbanner": true,
        "strupgradebannertext": "",
        "strupgradetopro": ""
    }
}}
{{#showbanner}}
<div style="position: absolute; top: -51px; width: 100%; left: 0; z-index: 3;">
    <div class="upgrade-to-pro-banner-wrapper">
        <span class="upgrade-to-pro-banner-text">
            {{strupgradebannertext}}
        </span>
        <a href="https://edwiser.org/page-builder-for-moodle/"
            target="_blank" class="upgrade-to-pro-btn"
            title="{{strupgradetopro}}">
        <span>{{strupgradetopro}}</span>
        </a>
    </div>
</div>
{{/showbanner}}
