{{!
    @template core_courseformat/local/linearnavigation/footer_content

    RemUI override for the course linear navigation footer content.
    Renders RemUI's actual prev/next action links (including subsection/section
    support) when available; falls back to styled core URLs otherwise.
}}
<div class="course-linear-navigation-footer-content d-flex w-100 align-items-center px-2 px-sm-0">
    {{! Previous button }}
    {{#prevlink}}
        {{> theme_remui/action_link_left }}
    {{/prevlink}}
    {{^prevlink}}
        {{#previousurl}}
        <a href="{{.}}" id="prev-activity-link" class="btn btn-secondary btn-sm d-flex align-items-center gap-1 text-decoration-none">
            <span class="edw-icon edw-icon-Left-Arrow font-size-16"></span>
            <span>{{#str}} previous, core {{/str}}</span>
        </a>
        {{/previousurl}}
    {{/prevlink}}

    <div class="d-flex align-items-center gap-4 ms-auto" data-for="course-linear-navigation-footer">
        {{! Completion status is displayed in the footer for linear navigation. }}
        {{#completion}}
        <div class="course-linear-navigation-completion">
            {{{ . }}}
        </div>
        <div class="vr"></div>
        {{/completion}}

        {{! Next / Back to course button }}
        {{#nextlink}}
            <div class="ms-auto">
                {{> theme_remui/action_link_right }}
            </div>
        {{/nextlink}}
        {{^nextlink}}
            {{#nexturl}}
            <a href="{{.}}" id="next-activity-link" class="btn btn-secondary btn-sm d-flex align-items-center gap-1 ms-auto text-decoration-none">
                <span>{{#str}} next, core {{/str}}</span>
                <span class="edw-icon edw-icon-Right-Arrow font-size-16"></span>
            </a>
            {{/nexturl}}
            {{#backtocourseurl}}
            <a href="{{.}}" class="btn btn-secondary btn-sm d-flex align-items-center gap-1 ms-auto text-decoration-none">
                <span>{{#str}} backtocourse, core {{/str}}</span>
            </a>
            {{/backtocourseurl}}
        {{/nextlink}}
    </div>
</div>
