<div class="row">
<div class="col-md-6"><h1>{{heading}}</h1></div>
<div class="col-md-6" style="text-align:right; font-size:20px"><a style="text-decoration:none"  href="{{link}}">List of teachers who agree with us</a></div>
</div>
<table id="example" class="table table-striped table-bordered list-of-faculty-agreement">
    <thead>
        <tr>
            <th>Name of Employee</th>
            <th>Email</th>

        </tr>
    </thead>
    <tbody>
        {{#agreements}}
        <tr>
            <td>{{firstname}} {{lastname}}</td>
            <td>{{email}}</td>

        </tr>
        {{/agreements}}
    <tbody>
</table>
<script>
    $(document).ready(function() {
        var table = $('#example').DataTable( {
            lengthChange: false,
            buttons: [ 'copy', 'excel', 'pdf', 'colvis' ]
        } );

        table.buttons().container()
            .appendTo( '#example_wrapper .col-md-6:eq(0)' );
    } );
</script>
